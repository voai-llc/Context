{
  "name": "context-file",
  "version": "0.1.0",
  "description": "Create and validate portable AI coding agent handoff files",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "context-file": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PROMPTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "context-file": "^0.0.0-stage",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
